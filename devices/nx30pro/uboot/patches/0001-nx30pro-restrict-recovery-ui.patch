index 3f7f213c..3074472a 100644
--- a/uboot-mtk-20250711/board/mediatek/Kconfig
+++ b/uboot-mtk-20250711/board/mediatek/Kconfig
@@ -331,6 +331,18 @@ config MEDIATEK_MTD_LAYOUT_PRINT
 	depends on MEDIATEK_MULTI_MTD_LAYOUT
 	default n
 
+config MTK_DEFAULT_MTD_LAYOUT
+	string "Default MTD layout label"
+	depends on MEDIATEK_MULTI_MTD_LAYOUT
+	default "default"
+	help
+	  Layout label that is used when the environment does not select one.
+	  The label has to exist in the /mtd-layout node of the board device
+	  tree; when it does not, the layout labelled "default" and otherwise the
+	  first layout of that node is used. A board whose shipped system needs
+	  another partition table than the stock one sets this to that label, so
+	  a device with an empty environment still boots the intended layout.
+
 config MTD_LAYOUT_SPI_NAND
 	bool "Replace nmbm0 with spi-nand0 in MTD layout"
 	depends on MEDIATEK_MULTI_MTD_LAYOUT
