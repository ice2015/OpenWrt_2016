# NX30 Pro device configuration layer (native OpenWrt Kconfig syntax).
#
# This file is a seed fragment, not a build report. devices/nx30pro/build/
# configure.sh merges the repository layers in the documented precedence
# common -> distribution -> device, feeds the result to the real
# `make defconfig`, and only then audits the FINAL .config with
# `firmware_lock.py verify-config`. A hard gate that defconfig drops fails
# there, before anything is compiled.
#
# Every symbol below is accounted for in devices/nx30pro/source-lock.json:
# it belongs to a package entry (with its feed commit and provider path), to
# the excluded package list, or to the dependency index. No symbol is a
# guess, and nothing here claims the package builds: the lock keeps the
# build blocked with status 3 until an authorized `make defconfig` probe
# proves the hard gates.

# Target and profile. The 112M profile is ported by
# devices/nx30pro/patches and checked against the partition contract of the
# boot loader by `verify-device-tree` and `verify-image-rules`.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7981=y
CONFIG_TARGET_mediatek_mt7981_DEVICE_h3c_nx30pro_112M=y

# Web interface: LuCI with HTTPS. luci-ssl-openssl is the HTTPS collector of
# the pinned luci feed (+luci +libustream-openssl +openssl-util).
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y

# Simplified Chinese. luci.mk generates the HIDDEN translation packages with
# DEFAULT:=LUCI_LANG_zh_Hans, so the language switch pulls the zh-cn
# translation of every installed LuCI package; luci-i18n-base-zh-cn is the
# base translation and a hard gate on its own.
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# Themes: Argon is the default interface, Bootstrap stays installed as the
# fallback so a broken theme cannot lock the operator out of LuCI. Which one
# is the default is a first boot UCI setting, not a build symbol.
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# Transparent proxy: PassWall pinned to 4.68 with the Xray backend. The two
# INCLUDE_ symbols are the PassWall Makefile's own Xray Core/Xray Plugin
# switches; xray-core and xray-plugin are listed as well because they are
# hard gates of their own and must not disappear behind the INCLUDE flags.
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_xray-plugin=y

# Dynamic DNS: the scripts plus the LuCI application that manages them.
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y

# Overlay networks: Tailscale daemon and client (the pinned luci feed has no
# luci-app-tailscale, which the lock records as UNRESOLVED) and ZeroTier with
# its LuCI application.
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y

# Container engine. dockerd, the docker client, the fuse-overlayfs storage
# backend for a NAND overlay and the LuCI management entry of this base.
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_fuse-overlayfs=y
CONFIG_PACKAGE_luci-app-docker=y

# Argo tunnel client.
CONFIG_PACKAGE_cloudflared=y

# Optional tools the design requires to be attempted and reported. Each one
# is read from the pinned feeds; whatever `make defconfig` makes of it is
# recorded in the verify-config report instead of being assumed here.
# Cloudflare DDNS provider for ddns-scripts.
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
# FRPC client from the frp package.
CONFIG_PACKAGE_frpc=y
# dnsmasq with the full feature set (see the dnsmasq override below).
CONFIG_PACKAGE_dnsmasq-full=y
# SQM/QoS scripts.
CONFIG_PACKAGE_sqm-scripts=y
# Per host traffic monitor.
CONFIG_PACKAGE_nlbwmon=y
# Wake on LAN.
CONFIG_PACKAGE_etherwake=y
# Web terminal.
CONFIG_PACKAGE_ttyd=y
# SFTP server.
CONFIG_PACKAGE_openssh-sftp-server=y
# Packet capture, mini variant (see the tcpdump override below).
CONFIG_PACKAGE_tcpdump-mini=y
# Throughput measurement.
CONFIG_PACKAGE_iperf3=y
# Route diagnostics.
CONFIG_PACKAGE_mtr=y

# Intentional overrides. Each line below replaces what an earlier layer or
# the upstream baseline enables, and each one is required by the package
# contract of the source lock.

# Excluded proxy managers: PassWall 4.68 with Xray is the only transparent
# proxy manager of this firmware. luci-app-openclash really exists in the
# pinned luci feed, so it has to be switched off explicitly; the others are
# recorded as absent from the pinned feeds and are switched off so a feed
# change cannot reintroduce them unnoticed.
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_luci-app-sing-box is not set

# WireGuard stays UNRESOLVED on this Linux 5.4 base: the backport and the
# KernelPackage exist, but `target/linux/generic/config-5.4` ships them
# switched off and no authorized probe proved they build for mediatek/mt7981.
# An unproven package may not ride along into the image, and the LuCI
# application is excluded with it: its LUCI_DEPENDS is
# +wireguard-tools +kmod-wireguard +luci-proto-wireguard, so it would pull
# both unproven symbols back in.
# CONFIG_PACKAGE_kmod-wireguard is not set
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set

# Documented rootfs clashes: the full tcpdump installs the same
# /usr/bin/tcpdump as tcpdump-mini, and dnsmasq installs the same
# /usr/sbin/dnsmasq as dnsmasq-full (which PROVIDES dnsmasq). The selected
# variant above replaces the baseline one, so the baseline one is switched
# off; verify-config refuses a final configuration that lost the replacement.
# CONFIG_PACKAGE_tcpdump is not set
# CONFIG_PACKAGE_dnsmasq is not set

# A second container manager next to luci-app-docker would ship two LuCI
# entries for the same engine. luci-app-docker is the management entry of
# this base.
# CONFIG_PACKAGE_luci-app-dockerman is not set

# ruby pulls a host Rust bootstrap that pushes the build past the runner
# limit, and no requirement of this firmware needs it.
# CONFIG_PACKAGE_ruby is not set
# CONFIG_PACKAGE_libruby is not set
