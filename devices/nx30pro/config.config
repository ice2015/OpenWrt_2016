# NX30 Pro device layer.
#
# Native OpenWrt configuration for the H3C Magic NX30 Pro with the 112 MiB
# UBI layout. The device profile comes from the locked source in
# devices/nx30pro/source-lock.json; the boot loader uses the same partition
# contract.

# Device profile
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7981=y
CONFIG_TARGET_mediatek_mt7981_DEVICE_h3c_nx30pro_112M=y

# Interface: Argon by default, Bootstrap as the second choice
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-argon-config=y

# Interface language
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-docker-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# Transparent proxy: PassWall with the xray backend is the only proxy manager
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_xray-plugin=y
CONFIG_PACKAGE_ip-full=y

# Cloud tunnel
CONFIG_PACKAGE_cloudflared=y

# Dynamic DNS
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y

# Overlay networks
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y

# Container engine
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_fuse-overlayfs=y
CONFIG_PACKAGE_luci-app-docker=y
CONFIG_PACKAGE_luci-lib-docker=y

# Uplink: PPPoE with IPv4 and IPv6
CONFIG_PACKAGE_odhcpd=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# Excluded on purpose, the reasons are in the source lock
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_ruby is not set
# CONFIG_PACKAGE_libruby is not set
