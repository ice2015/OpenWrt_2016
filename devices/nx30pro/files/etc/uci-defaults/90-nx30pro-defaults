#!/bin/sh
# NX30 Pro first boot defaults.
#
# Nothing in this file enables a service that needs an account, a token or a
# subscription. Every service stays switched off until it is configured.
set -eu

# The directory that holds the deployment specific values. The WAN MAC file
# is written by the operator, it is never part of the image.
mkdir -p /etc/nx30pro

uci -q set luci.main.mediaurlbase='/luci-static/bootstrap' 2>/dev/null || true
uci -q delete luci.main.mediaurlbase 2>/dev/null || true
uci -q set luci.main.resourcebase='/luci-static/argon' 2>/dev/null || true

# Transparent proxy: stays off until a node is configured.
uci -q set passwall.enabled='0' 2>/dev/null || true

# Dynamic DNS: stays off until a provider and a domain are configured.
uci -q set ddns.enabled='0' 2>/dev/null || true

# Overlay networks: stay off until an account is added.
uci -q set tailscale.enabled='0' 2>/dev/null || true
uci -q set zerotier.enabled='0' 2>/dev/null || true

# Container engine: stays off until a storage driver and a data directory
# are confirmed on the device.
uci -q set docker.enabled='0' 2>/dev/null || true

# The management interfaces stay in the lan zone only. The image never opens
# the router ports to the wan zone.
uci -q set firewall.@zone[1].input='REJECT' 2>/dev/null || true

exit 0
