config interface 'wan'
	option device 'eth0'
	option proto 'dhcp'
	option metric '10'

config interface 'wwan'
	option proto 'dhcp'
	option metric '20'
	option auto '0'

config interface 'usbwan'
	option proto 'dhcp'
	option metric '30'
	option auto '0'

config device 'br_lan'
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.10.1'
	option netmask '255.255.255.0'

config interface 'plant'
	option proto 'none'
